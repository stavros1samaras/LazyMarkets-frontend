{
    "js/ts.tsdk.path": "node_modules\\typescript\\lib",
    "editor.tokenColorCustomizations": {
    "comments": "#51d33e4e",
     "textMateRules": [
        {
            "scope": "storage.type.class.jsdoc",
            "settings": {
                "foreground": "#4f7ebec5"
            }
        }
    ]
    },
    "symbols.files.associations": {
    "*.json":"brackets-yellow",
    "config.ts": "database",
    "components.json": "brackets-yellow",
    "package-lock.json": "brackets-yellow",
    "package.json": "brackets-yellow",
    "skills-lock.json": "brackets-yellow",
    "tsconfig.json": "brackets-yellow",
    "types.ts": "ts-types",    
    "actions.ts": "code-red",
    "modules.ts": "code-purple",
    "server.ts": "code-red",
    "*.server.ts": "code-red",
    "*.actions.ts": "code-red",
    "i18n.js" : "i18n",
    "hooks.ts":"react",
    "*.provider.tsx": "redux-actions",
    "*.context.ts": "redux-actions",
    "contexts.ts": "redux-actions",
    "*.CSR.tsx" : "globe",
    "*.config.ts": "database",
    "robots.ts": "robot",
    "playwright.config.ts": "brackets-green"
  },
  "symbols.folders.associations": {
    "components": "folder-react",
    "styles": "folder-purple-outline",
    "app": "folder-router",
    "_features": "folder-layout",
    "archived": "ignore",
    "public": "folder-assets",
    ".opencode": "folder-claude",
    ".agents": "folder-claude",
    "server": "folder-red-outline",
    "_actions": "folder-red-outline"
  },
  "chat.tools.terminal.autoApprove": {
    "npx tsc": true
  },
  // https://github.com/miguelsolorio/vscode-symbols/blob/HEAD/preview/preview.md
  // "symbols.subfolder.file.associations": {
  //   "data-fetchers": {
  //     "*.ts": "folder-red-outline",
  //   }
  // }

  "better-comments.tags": [
  {
    "tag": "!",
    "color": "#FF2D00",
    "strikethrough": false,
    "underline": false,
    "backgroundColor": "transparent",
    "bold": false,
    "italic": false
  },
  {
    "tag": "?",
    "color": "#3498DB",
    "strikethrough": false,
    "underline": false,
    "backgroundColor": "transparent",
    "bold": false,
    "italic": false
  },
  {
    "tag": "//",
    "color": "#474747",
    "strikethrough": true,
    "underline": false,
    "backgroundColor": "transparent",
    "bold": false,
    "italic": false
  },
  {
    "tag": "todo",
    "color": "#FF8C00",
    "strikethrough": false,
    "underline": false,
    "backgroundColor": "transparent",
    "bold": false,
    "italic": false
  },
  {
    "tag": "*",
    "color": "#98C379",
    "strikethrough": false,
    "underline": false,
    "backgroundColor": "transparent",
    "bold": false,
    "italic": false
  }
]
}